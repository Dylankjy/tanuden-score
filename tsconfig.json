{
  "include": ["src/**/*"],
  "compilerOptions": {
    "sourceMap": true,
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],

    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "noUncheckedIndexedAccess": true,

    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,

    "rootDir": "src",
    "outDir": "dist"
  }
}
