{
  "name": "tanuden-score",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node -r dotenv/config ./dist/index.js",
    "migrate:myuntendai": "node -r dotenv/config ./dist/scripts/migrate-from-myuntendai.js",
    "reevaluate": "node -r dotenv/config ./dist/scripts/reevaluate-record.js",
    "dev": "nodemon -L -e ts,js,json --exec \"npm run build && npm run start\" || exit 1",
    "dev:debug": "nodemon -L -e ts,js,json --exec \"npm run build && node --inspect=0.0.0.0:9229 -r dotenv/config ./dist/index.js\" || exit 1",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "format": "prettier --config .prettierrc.cjs --write **/*.{ts,js,cjs,json,yml,yaml}",
    "format:check": "prettier --config .prettierrc.cjs --check **/*.{ts,js,cjs,json,yml,yaml}"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@tanuden/rudolf": "^0.1.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "http-graceful-shutdown": "^3.1.15",
    "http-status": "^2.1.0",
    "jszip": "^3.10.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.23",
    "luxon": "^3.7.2",
    "mongo-sanitizer": "^1.0.4",
    "mongoose": "^9.1.3",
    "morgan": "^1.10.1",
    "ms": "^2.1.3",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "socket.io": "^4.8.3",
    "stats-lite": "^2.2.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.23",
    "@types/luxon": "^3.7.1",
    "@types/morgan": "^1.9.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.0.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/stats-lite": "^2.2.2",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "prettier-plugin-packagejson": "^2.5.21",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  }
}
