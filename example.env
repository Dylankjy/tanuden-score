# ----------------------------------------------------
# Tanuden Score Configuration
# ----------------------------------------------------
NODE_ENV=development

# Service binding configuration. Score sits behind tanuden-gateway (which routes
# /score -> this service); it is never exposed to clients directly.
WEBSERVER_SERVICE_URL=http://localhost
WEBSERVER_PORT=5005

# Path to the PUBLIC key matching the gateway's JWT signing key (used to verify
# gateway-issued tokens on both REST requests and socket connections). Must be
# the counterpart of the gateway's WEBSERVER_JWT_SECRET_KEY_PATH.
WEBSERVER_JWT_PUBLIC_KEY_PATH=./keys/gateway-public.pem

# MongoDB Connection — deliberately its own database, not shared with
# tanuden-myuntendai, so migrating historical data is a separate, explicit step.
DB_CONNECTION_STRING=mongodb://localhost:27017/tanuden-score

# Only read by scripts/migrate-from-myuntendai.ts (npm run migrate:myuntendai)
# — the source database for the one-time historical-data migration.
LEGACY_DB_CONNECTION_STRING=mongodb://localhost:27017/tanuden-myuntendai

# Shared gateway/upstream secret — sent as x-internal-secret when polling
# auth's internal deletion-event feed. Must match the gateway's INTERNAL_SECRET.
INTERNAL_SECRET=

# tanuden-auth base URL (direct, not via the gateway) — polled by the deletion
# sync job for anonymized-account events (see src/jobs/deletion-sync.job.ts).
AUTH_SERVICE_URL=http://localhost:5001

# Internal service name
API_SERVICE_NAME="Tanuden Score"
